DJANGO_SECRET_KEY=replace-with-a-unique-secret-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,172.18.6.25

# Existing SQL Server connection values (set according to your POS database)
DB_NAME=posApp
DB_HOST=localhost\SQLEXPRESS
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
POS_DB_EXTRA_PARAMS=TrustServerCertificate=yes;Encrypt=no;

# Same value as ERP
POS_LINK_SHARED_SECRET=replace-with-the-same-long-random-secret-as-ERP
ERP_PUBLIC_BASE_URL=http://127.0.0.1:8000
POS_PUBLIC_BASE_URL=http://172.18.6.25:8000

# Configure payment/email secrets only if those integrations are used
SMILE_PAY_MERCHANT_ID=
SMILE_PAY_API_KEY=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
